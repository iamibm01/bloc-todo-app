// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - represents the 'users' table in PostgreSQL
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  // Relations
  tasks     Task[]
  projects  Project[]
}

// Project model - organizational containers for tasks
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#FFD5E5")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([userId])
}

// Task model - individual todo items with advanced features
model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("brainstorm") // brainstorm, todo, inProgress, done
  priority    String   @default("medium")     // low, medium, high
  tags        String[] @default([])
  dueDate     DateTime?
  completedAt DateTime?
  order       Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
}
